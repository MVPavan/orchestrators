{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestrators.local/schemas/capability-probe-metrics-v1.json",
  "title": "Externally measured capability-probe metrics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "tool_lane",
    "classification",
    "fixture_manifest_sha256",
    "source_commit",
    "model",
    "reasoning_effort",
    "runtime_version",
    "provider_usage",
    "artifact_estimates",
    "evidence_counts",
    "operations",
    "elapsed_ms",
    "contamination"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string"
    },
    "tool_lane": {
      "enum": [
        "codegraph",
        "cbm",
        "graphify"
      ]
    },
    "classification": {
      "enum": [
        "DISCOVERY_SETUP",
        "CAPABILITY_PROBE",
        "SMOKE_EXCLUDED"
      ]
    },
    "fixture_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "model": {
      "const": "gpt-5.6-terra"
    },
    "reasoning_effort": {
      "const": "medium"
    },
    "runtime_version": {
      "type": "string"
    },
    "provider_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "measurement_source"
      ],
      "properties": {
        "input_tokens": {
          "$ref": "#/$defs/countOrUnknown"
        },
        "cached_input_tokens": {
          "$ref": "#/$defs/countOrUnknown"
        },
        "output_tokens": {
          "$ref": "#/$defs/countOrUnknown"
        },
        "reasoning_tokens": {
          "$ref": "#/$defs/countOrUnknown"
        },
        "measurement_source": {
          "const": "provider_completion_event"
        }
      }
    },
    "artifact_estimates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokenizer",
        "schema_tokens",
        "raw_output_tokens",
        "raw_output_bytes"
      ],
      "properties": {
        "tokenizer": {
          "const": "gpt-tokenizer@3.4.0:o200k_base"
        },
        "schema_tokens": {
          "$ref": "#/$defs/countOrUnknown"
        },
        "raw_output_tokens": {
          "$ref": "#/$defs/countOrUnknown"
        },
        "raw_output_bytes": {
          "$ref": "#/$defs/countOrUnknown"
        }
      }
    },
    "evidence_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_returned_source",
        "tool_graph_fact",
        "tool_status",
        "documentation_only"
      ],
      "properties": {
        "tool_returned_source": {
          "type": "integer",
          "minimum": 0
        },
        "tool_graph_fact": {
          "type": "integer",
          "minimum": 0
        },
        "tool_status": {
          "type": "integer",
          "minimum": 0
        },
        "documentation_only": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_calls",
        "file_reads",
        "fallback_searches"
      ],
      "properties": {
        "tool_calls": {
          "$ref": "#/$defs/countOrUnknown"
        },
        "file_reads": {
          "$ref": "#/$defs/countOrUnknown"
        },
        "fallback_searches": {
          "$ref": "#/$defs/countOrUnknown"
        }
      }
    },
    "elapsed_ms": {
      "type": "integer",
      "minimum": 0
    },
    "contamination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cross_tool_output_seen",
        "expected_anchors_seen",
        "subject_repo_seen",
        "independent_source_access",
        "unauthorized_operation",
        "notes"
      ],
      "properties": {
        "cross_tool_output_seen": {
          "type": "boolean"
        },
        "expected_anchors_seen": {
          "type": "boolean"
        },
        "subject_repo_seen": {
          "type": "boolean"
        },
        "independent_source_access": {
          "type": "boolean"
        },
        "unauthorized_operation": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "countOrUnknown": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "const": "UNKNOWN"
        }
      ]
    }
  }
}
