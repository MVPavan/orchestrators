            "type": "string"
          },
          "result": {
            "enum": [
              "SUCCESS",
              "PARTIAL",
              "NOT_APPLICABLE",
              "UNAVAILABLE",
              "FAILED"
            ]
          },
          "output_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
