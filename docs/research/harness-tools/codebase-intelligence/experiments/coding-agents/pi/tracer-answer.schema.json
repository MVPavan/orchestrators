{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestrators.local/schemas/pi-tracer-answer-v1.json",
  "title": "Pi primary agent-turn tracer answer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "question_id",
    "run_status",
    "summary",
    "lifecycle",
    "boundaries",
    "failure_and_cancellation",
    "inferences",
    "open_questions",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "question_id": {
      "type": "string",
      "const": "PI-T01"
    },
    "run_status": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "PARTIAL",
        "FAILED"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lifecycle_step"
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/boundary"
      }
    },
    "failure_and_cancellation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "inferences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inference"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "symbol",
        "claim"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^([^./\\\\]|\\.([^.\\\\]|$))([^.\\\\]|\\.([^.\\\\]|$))*$"
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "claim": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "evidence"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "lifecycle_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "component",
        "action",
        "state_change",
        "evidence"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "state_change": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "description",
        "evidence"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "SYSTEM",
            "CONTROL",
            "DATA",
            "STATE",
            "TRUST"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "basis"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
